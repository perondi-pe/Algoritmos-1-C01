#include<iostream>
using namespace std;

int main(){
    int n, m;
    cin >> n >> m;
    cin.ignore();
    string mensagem;
    getline(cin, mensagem);
    char mat[100][100];
    int letra = 0;
    for(int i = 0; i < n; i++){
        for(int j = 0; j < m; j++){
            mat[i][j] = mensagem[letra];
            letra++;
        }
    }
    for(int j = 0; j < m; j++){
        for(int i = 0; i < n; i++){
            cout << mat[i][j];
        }
    }
}
